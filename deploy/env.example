# Copy to `.env` beside docker-compose.yml and edit. `.env` is the
# operator's file: it is not in this repository and must not be added to it.
#
# No secret is written here — only the *path* to one (invariant 7).

# The file holding the one shared token every requester must carry (Q8).
# Make it like this, outside any repository:
#
#   install -d -m 0700 /etc/herd
#   head -c 32 /dev/urandom | base64 > /etc/herd/requester-token
#   chmod 0400 /etc/herd/requester-token
#
# Requesters then carry it as `herdctl --token` or HERD_TOKEN.
HERD_REQUESTER_TOKEN_FILE=/etc/herd/requester-token
